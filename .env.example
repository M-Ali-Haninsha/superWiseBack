# Copy to .env and fill in real values. Never commit .env.
DATABASE=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/superWise
JWT_SECRET=<long random string>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Gmail address + app password used to send OTP emails
MAIL_USER=
MAIL_PASS=

# Optional
# PORT=3000
# JWT_EXPIRES_IN=2h
# Comma-separated browser origins allowed to call the API (default: any)
# CORS_ORIGIN=https://superwise.vercel.app,http://localhost:4200
